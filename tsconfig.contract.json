{
  // The TYPE half of the §9.4 contract agreement (§9.6-E1), on its own. Emits nothing.
  //
  // `npm run typecheck` checks `src/library/contract.agreement.ts` too, since §9.6-E4 made the contract
  // an ordinary module. This config runs it alone, as its own CI step, so that a failure there names
  // the contract table rather than one error among the whole source's. It extends the typecheck
  // config, so the two cannot check the contract under different rules.
  //
  // Run by `npm run typecheck:contract`.
  "extends": "./tsconfig.json",
  "include": [],
  "files": [
    "src/library/contract.agreement.ts"
  ]
}
