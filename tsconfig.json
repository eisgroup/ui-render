{
  // The TYPECHECK config (§9.6-E0). It emits nothing — `tsc --noEmit`, run as `npm run typecheck`.
  //
  // Why a checker at all when Babel already compiles TypeScript: Babel STRIPS types, file by file,
  // and never verifies them. Without this file a `.ts` module would build and ship with its types
  // unchecked, which is worse than having no types. Babel is the compiler; this is the check.
  //
  // The package's declarations come from `tsconfig.build.json`, which EXTENDS this file and switches
  // declaration emit on (§9.6-E4, `npm run gen-ts`). Keep every checking rule here: the declarations a
  // host gets are then checked exactly as the source is.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react",

    "noEmit": true,
    "strict": true,

    // JavaScript is not part of the program (§9.6, the migration's last step). `src/core` and
    // `src/library` are TypeScript throughout; the demo and the test suites stay JavaScript, which
    // this config does not check, and a `.ts` file importing a `.js` module fails here instead of
    // trusting it. During the migration this was `allowJs: true` with `checkJs: false`, so that a
    // converted file could import an unconverted one.
    "allowJs": false,

    // REQUIRED, not a preference. Babel compiles each file alone, with no cross-file knowledge, so
    // constructs whose meaning depends on the whole program (re-exported types without `export type`,
    // `const enum`) compile to something subtly wrong instead of failing. This makes tsc reject them,
    // so the checker and the compiler agree about what the code means.
    "isolatedModules": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
