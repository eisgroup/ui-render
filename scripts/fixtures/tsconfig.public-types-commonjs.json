{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    // A host on settings TypeScript 6 deprecates, which the declarations must still compile for. 6 errors on
    // them without this; 7 drops them, so this matrix will need a 6 compiler of its own then.
    "ignoreDeprecations": "6.0",
    "lib": ["ES2019", "DOM"],
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["react"]
  },
  "files": ["public-types-commonjs-consumer.tsx"]
}
