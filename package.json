{
  "name": "eis-ui-render",
  "version": "0.34.3",
  "description": "UI generation based on JSON schemas",
  "homepage": "https://eisgroup.github.io/ui-render/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eisgroup/ui-render.git"
  },
  "bugs": {
    "url": "https://github.com/eisgroup/ui-render/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.9.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "static/",
    "meta.schema.json",
    "package.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "docs/SUPPORTED-PROPS.md",
    "docs/SUPPORTED-VIEWS.md"
  ],
  "scripts": {
    "start": "webpack serve --mode development --config webpack.demo.config.mjs",
    "build": "webpack --mode production --config webpack.demo.config.mjs && cp build/index.html build/404.html",
    "build-lib": "webpack --mode production --config webpack.library.config.mjs && npm run gen-ts",
    "watch-lib": "npm run gen-ts && webpack --watch --mode production --config webpack.library.config.mjs",
    "yalc-publish": "npm run build-lib && yalc publish --push",
    "yalc-watch": "nodemon --watch src --ext js,jsx,ts,tsx --exec 'npm run yalc-publish'",
    "gen-ts": "node scripts/gen-ts.js",
    "typecheck": "tsc --noEmit",
    "typecheck:contract": "tsc --project tsconfig.contract.json",
    "serve-dist": "serve dist -p 3102",
    "serve-build": "serve build -p 3103",
    "deploy": "gh-pages -d build",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:types": "npm run build-lib && npm run test:types:consumer",
    "test:types:consumer": "node scripts/test-public-types.js",
    "test:pack": "npm run build-lib && npm run test:pack:budget && npm run test:pack:consumer",
    "test:css:built": "jest --config jest.built-css.config.js",
    "test:pack:budget": "node scripts/check-package-budget.js",
    "test:pack:consumer": "node scripts/test-packed-consumer.js",
    "test:pack:peers": "node scripts/test-packed-react-matrix.js",
    "test:env-flags": "node scripts/test-env-flags.js",
    "test:react16": "jest --config jest.react16.config.js",
    "test:react17": "jest --config jest.react17.config.js",
    "test:react19": "jest --config jest.react19.config.js",
    "test:watch": "jest --watch",
    "build-css": "node scripts/build-css.js",
    "build-css:check": "node scripts/build-css.js --check",
    "docs:views": "node scripts/generate-view-reference.js",
    "docs:views:check": "node scripts/generate-view-reference.js --check",
    "docs:props": "node scripts/generate-wrapper-prop-reference.js",
    "docs:props:check": "node scripts/generate-wrapper-prop-reference.js --check",
    "prepack": "npm run sync-version -- --check && npm run docs:views:check && npm run docs:props:check && npm run build-lib",
    "sync-version": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js && git add src/library/AppWrapper.tsx public/index.html",
    "lint:js": "eslint src --max-warnings 0",
    "lint:css": "stylelint 'src/style/**/*.less'",
    "css:fixture": "node scripts/generate-semantic-css-fixture.js",
    "css:fixture:check": "node scripts/generate-semantic-css-fixture.js --check"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions"
  ],
  "peerDependencies": {
    "moment": "^2.29.4",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "1.63.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "axios": "^1.8.4",
    "babel-loader": "^10.0.0",
    "confusing-browser-globals": "^1.0.11",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "final-form": "^4.20.9",
    "final-form-arrays": "^3.1.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "less": "^4.4.2",
    "less-loader": "^13.0.0",
    "less-plugin-functions": "^1.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "moment": "~2.31.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.8",
    "postcss-less": "^6.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-prefixwrap": "^1.55.0",
    "process": "^0.11.10",
    "rc-picker": "4.11.3",
    "react": "^18.3.1",
    "react-16-floor": "file:scripts/fixtures/react16-floor",
    "react-17-floor": "file:scripts/fixtures/react17-floor",
    "react-19": "file:scripts/fixtures/react19",
    "react-dom": "^18.3.1",
    "react-final-form": "^6.5.9",
    "react-final-form-arrays": "^3.1.4",
    "react-markdown": "^10.1.0",
    "react-refresh": "^0.19.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.1",
    "react-types-16": "npm:@types/react@16.14.70",
    "react-types-17": "npm:@types/react@17.0.93",
    "react-types-19": "npm:@types/react@19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-toc": "^9.0.0",
    "serve": "^14.2.4",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.99.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "fsevents": "^2.3.2"
  }
}
