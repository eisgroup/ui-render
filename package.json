{
  "name": "eis-ui-render",
  "version": "0.34.3",
  "description": "UI generation based on JSON schemas",
  "homepage": "https://eisgroup.github.io/ui-render/",
  "license": "Apache 2.0",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "static/",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "webpack serve --mode development --config webpack.demo.config.mjs",
    "build": "webpack --mode production --config webpack.demo.config.mjs && cp build/index.html build/404.html",
    "build-lib": "webpack --mode production --config webpack.library.config.mjs && npm run gen-ts",
    "watch-lib": "webpack --watch --mode production --config webpack.watch.config.mjs",
    "yalc-publish": "npm run build-lib && yalc publish --push",
    "yalc-watch": "nodemon --watch src --ext js,jsx,ts,tsx --exec 'npm run yalc-publish'",
    "gen-ts": "tsc --project tsconfig.build.json",
    "serve-dist": "serve dist -p 3102",
    "serve-build": "serve build -p 3103",
    "deploy": "gh-pages -d build",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:types": "npm run build-lib && npm run test:types:consumer",
    "test:types:consumer": "node scripts/test-public-types.js",
    "test:pack": "npm run build-lib && npm run test:pack:budget && npm run test:pack:consumer",
    "test:pack:budget": "node scripts/check-package-budget.js",
    "test:pack:consumer": "node scripts/test-packed-consumer.js",
    "test:pack:peers": "node scripts/test-packed-react-matrix.js",
    "test:react16": "jest --config jest.react16.config.js",
    "test:react17": "jest --config jest.react17.config.js",
    "test:watch": "jest --watch",
    "build-css": "node scripts/build-css.js",
    "prepack": "npm run sync-version -- --check && npm run build-lib",
    "sync-version": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js && git add src/library/AppWrapper.js public/index.html",
    "lint:js": "eslint src --ext .js,.jsx --max-warnings 0",
    "lint:css": "stylelint 'src/style/**/*.less'"
  },
  "eslintConfig": {
    "extends": "react-app",
    "parserOptions": {
      "ecmaFeatures": {
        "legacyDecorators": true
      }
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "peerDependencies": {
    "moment": "^2.29.4",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "final-form": "^4.20.9",
    "final-form-arrays": "^3.1.0",
    "prop-types": "^15.8.1",
    "rc-picker": "4.11.3",
    "react-final-form": "^6.5.9",
    "react-final-form-arrays": "^3.1.4",
    "semantic-ui-react": "^3.0.0-beta.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "axios": "^1.8.4",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv-webpack": "^8.0.1",
    "eslint": "^8.56.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "5.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "less": "^3.13.1",
    "less-loader": "^12.2.0",
    "less-plugin-functions": "^1.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "moment": "~2.29.4",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.8",
    "postcss-less": "^6.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-prefixwrap": "^1.55.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-16-floor": "file:scripts/fixtures/react16-floor",
    "react-17-floor": "file:scripts/fixtures/react17-floor",
    "react-dom": "^18.3.1",
    "react-markdown": "^8.0.7",
    "react-refresh": "^0.17.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-types-16": "npm:@types/react@16.14.70",
    "react-types-17": "npm:@types/react@17.0.93",
    "remark-gfm": "^3.0.1",
    "remark-toc": "^9.0.0",
    "semantic-ui-less": "2.5.0",
    "serve": "^14.2.4",
    "style-loader": "^3.3.4",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "overrides": {
    "fsevents": "^2.3.2"
  }
}
